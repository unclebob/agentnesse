<script src="/files/agnesse/javascript/mousetrap.min.js" type="text/javascript"></script>

<form method="post" action="$resource" name="f" class="mousetrap">
#if($!redirect)
 <input type="hidden" name="redirect" value="#escape($redirect)"/>
#end
#if($!isNewPage)
 <input type="hidden" name="responder" value="new"/>
 <fieldset>
  <label for="pagename">Page name:</label>
  <input type="text" id="pagename" name="pageName" value="#escape($!pageName)" class="wikiword" />
 </fieldset>
 #if( $!pageType )
 <input type="hidden" name="pageType" value="#escape($pageType)"/>
 #else
 <fieldset id="pagetypes">
  #foreach( $type in $pageTypes )
  <label for="pageType_$type"><input type="radio" name="pageType" value="$type" id="pageType_$type"#if($type == $selectedType) checked="checked"#end/> $type</label>
  #end
  <label for="pageType_Default"><input type="radio" name="pageType" value="Default" id="pageType_Default"#if(!$selectedType || $selectedType == "Default") checked="checked"#end /> Default</label>
 </fieldset>
 #end
#else
 <input type="hidden" name="responder" value="saveData"/>
#end
 #if($error)
 <p class="error">#escape($error)</p>
 #end
 <details id="front-matter"#if($frontMatterOpen) open#end>
  <summary>Front Matter #if($frontMatterOpen)▾#else▸#end</summary>
  <textarea class="no_wrap mousetrap" id="frontMatter" name="frontMatter" wrap="off">$!frontMatter</textarea>
 </details>
 <fieldset id="editor">
  <textarea class="wikitext no_wrap mousetrap" id="pageContent" name="pageContent" wrap="off">$pageContent</textarea>
 </fieldset>

 <fieldset id="save_buttons">
  <input type="submit" name="save" value="Save" accesskey="s"/>
  <a class="button" href="#if($!redirect)#escape($redirect)#else$resource#end">Cancel</a>
 </fieldset>
</form>

<link rel="stylesheet" type="text/css" href="/files/agnesse/codemirror/codemirror.css" />
<script src="/files/agnesse/javascript/jquery-3.5.1.min.js" type="text/javascript"></script>
<script src="/files/agnesse/codemirror/codemirror.js" type="text/javascript"></script>
<script src="/files/agnesse/codemirror/mode/markdown/markdown.js" type="text/javascript"></script>
<script type="text/javascript">
$(function () {
  var textarea = document.getElementById('pageContent');
  var editor = null;

  #if($!isNewPage)
    document.f.pageName.focus();
  #else
    if (window.CodeMirror) {
      editor = CodeMirror.fromTextArea(textarea, { mode: "markdown", lineWrapping: true });
      editor.getInputField().classList.add("mousetrap");
    } else {
      textarea.focus();
    }
  #end

  function fieldValues() {
    if (editor) editor.save();
    return $.map($('#pageContent,#frontMatter', document.f), function(e) { return $(e).val(); });
  }

  var matterBox = document.getElementById('front-matter');
  matterBox.addEventListener('toggle', function () {
    matterBox.querySelector('summary').textContent = matterBox.open ? 'Front Matter ▾' : 'Front Matter ▸';
    $(window).resize();
  });

  #if($!isNewPage)
  var adjunctNames = [$adjunctNames];
  var adjunctType = '$adjunctType';
  function frontMatterFor(value) {
    var literal = {Test: '"test"', Suite: '"suite"', Static: '"static"'}[value];
    if (literal) return literal;
    if (value === adjunctType) return '"' + adjunctType + '"';
    return 'null';
  }
  $('input[type=radio][name=pageType]').on('change', function () {
    var literal = frontMatterFor(this.value);
    var area = document.getElementById('frontMatter');
    var pattern = new RegExp('"type"\\s*:\\s*(?:"(?:' + adjunctType + '|test|suite|static)"|null)');
    var next = area.value.replace(pattern, '"type": ' + literal);
    area.value = next === area.value
      ? '{\n  "type": ' + literal + ',\n  "tags": [],\n  "help": null,\n  "prune": false\n}'
      : next;
  });
  $('#pagename').on('input', function () {
    if (adjunctNames.indexOf(this.value) < 0) return;
    var radio = document.getElementById('pageType_' + adjunctType);
    if (!radio) return;
    radio.checked = true;
    $(radio).trigger('change');
  });
  #end

  var originalFieldValues = fieldValues();
  var performingSubmit = false;

  $(document.f).submit(function () {
    performingSubmit = true;
    if (editor) editor.save();
  });

  window.onbeforeunload = function () {
    if (performingSubmit) {
      return;
    }
    if (fieldValues().join('$$') !== originalFieldValues.join('$$')) {
      return "The page content has been changed.\nDo you really want to leave this page?";
    }
  };

  $(window).resize(function () {
    var h = $('#save_buttons').position().top;
    if (editor) {
      editor.setSize("100%", h - $(editor.getWrapperElement()).position().top - 6);
    } else {
      $(textarea).height(h - $(textarea).position().top - 6);
    }
  }).resize();

  Mousetrap.bind('ctrl+s', function(e) {
    performingSubmit = true;
    if (editor) editor.save();
    $(document.f).submit();
    return false;
  });
  Mousetrap.bind('esc', function(e) {
    window.location.href ="#if($!redirect)#escape($redirect)#else$resource#end";
    return false;
  });
});
</script>
