<!DOCTYPE html>
<html>
 <head>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
  <title>$title</title>
  ## Deal with HTML 5 element in older IE browsers
  <!--[if lt IE 9]>
   <script>
    document.createElement('header');
    document.createElement('nav');
    document.createElement('section');
    document.createElement('article');
    document.createElement('footer');
   </script>
  <![endif]-->

  <link rel="stylesheet" type="text/css" href="/files/fitnesse/css/agentnesse.css" />
  <link rel="shortcut icon" type="image/png" href="/files/fitnesse/images/favicon.png" />
  <script src="/files/fitnesse/javascript/agnesse.js" type="text/javascript"></script>
 </head>
 <body#if( $bodyClass ) class="$bodyClass"#end>

  <header>
   #parse( $headerTemplate )
  </header>

  #if( $!errorNavTemplate )
   #parse( $errorNavTemplate )
  #end

  <nav>
   #parse( $navTemplate )
  </nav>

  <article>
   #parse( $mainTemplate )
  </article>

  #if( $!footerTemplate )
  <footer>
   #parse( $footerTemplate )
  </footer>
  #end

 </body>
</html>
