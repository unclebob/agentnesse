<h1>Defined variables</h1>
#if($variables.size() > 0)
<table id="definedVariables" class="dirListing">
 <thead>
  <tr>
   <th>Variable name</th>
   <th>Variable value</th>
   <th>Variable location</th>
  </tr>
 </thead>
 <tbody>
  #foreach ($entry in $variables)
    <tr>
      <td>$entry.getKey()</td>
      <td>$entry.getValue()</td>
      <td><a href="$entry.getLocation()">$entry.getLocation()</a></td>
     </tr>
  #end
 </tbody>
</table>
#else
<h2>There are no variables defined for page: $pageTitle.Title</h2>
#end
<fieldset>
 <a class="button" href="$viewLocation">Back</a>
</fieldset>


