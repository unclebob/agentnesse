{:paths ["src" "test"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases
 {:test {:main-opts ["-m" "agnesse.slim-test"]}
  :cov {:extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
        :main-opts ["-m" "cloverage.coverage"
                    "--src-ns-path" "src"
                    "--test-ns-path" "test"
                    "--runner" ":clojure.test"
                    "--ns-exclude-regex" "agnesse\\.slim-test"
                    "-m" "agnesse.slim-test"]}}}
